<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>Refrain</RootNamespace>
    <AssemblyName>Refrain</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>Assets\refrain.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Unpackaged, carrying the Windows App SDK and .NET: what the installer ships. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <!-- The WinUI component only: the full Windows App SDK adds ~150 MB of AI and search runtimes. -->
    <PackageReference Include="Microsoft.WindowsAppSDK.WinUI" Version="2.6.4" />
    <!-- TagLib# makes its format classes by reflection: keep all of it under Native AOT. -->
    <TrimmerRootAssembly Include="TagLibSharp" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Refrain.Core\Refrain.Core.csproj" />
    <!-- One entry list for Explorer's menu and the app's (SPEC §35): the handler's own file, compiled here too. -->
    <Compile Include="..\RefrainMenu\MenuLogic.cs" Link="Entries\MenuLogic.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\refrain.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- rsgain is bundled, never configurable (Ground rule 5). -->
    <Content Include="..\..\resources\rsgain\**" Link="rsgain\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- flac too: the cue split and Trim cut and prove with it. -->
    <Content Include="..\..\resources\flac\**" Link="flac\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
