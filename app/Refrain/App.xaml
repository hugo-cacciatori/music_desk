<Application
    x:Class="Refrain.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:Refrain.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- The WinUI control resources: without them the app crashes at start. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- One row of a file table; FileTable fills it in ContainerContentChanging. -->
            <DataTemplate x:Key="FileRowTemplate">
                <views:RowView />
            </DataTemplate>

            <Style x:Key="FileRowItemStyle" TargetType="ListViewItem" BasedOn="{StaticResource DefaultListViewItemStyle}">
                <Setter Property="MinHeight" Value="30" />
                <Setter Property="Padding" Value="4,0,0,0" />
                <Setter Property="HorizontalContentAlignment" Value="Left" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
